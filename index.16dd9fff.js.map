"use strict";
var thumbs = document.querySelector("#thumbs");
var bigImage = document.querySelector(".gallery__large-img");
thumbs.addEventListener("click", function(smth) {
    smth.preventDefault();
    var link = smth.target.closest(".list-item__link");
    if (!link) return;
    bigImage.src = link.href;
});

